erDiagram
    AUTH_USERS ||--|| PROFILES : "has profile"
    PROFILES ||--o{ CUSTOMERS : "created_by"
    PROFILES ||--o{ ORDERS : "created_by"
    CUSTOMERS ||--o{ ORDERS : "places"
    ORDERS ||--|{ ORDER_ITEMS : "contains"
    PRODUCTS ||--o{ ORDER_ITEMS : "ordered as"
    ORDERS ||--o{ STORAGE_ORDER_FILES : "attachments (order-files/order_id/)"
    PRODUCTS ||--o| STORAGE_PRODUCT_IMAGES : "image_path (product-images)"

    AUTH_USERS {
        uuid id PK
        text email
        jsonb raw_user_meta_data
    }
    PROFILES {
        uuid id PK "FK auth.users"
        text full_name
        user_role role "admin | staff | pending"
        timestamptz created_at
    }
    CUSTOMERS {
        bigint id PK
        text full_name
        text phone
        text email
        text address
        text notes
        uuid created_by FK
        timestamptz created_at
        timestamptz updated_at
    }
    PRODUCTS {
        bigint id PK
        text name
        text category
        text description
        numeric price
        text image_path
        boolean is_active
        timestamptz created_at
        timestamptz updated_at
    }
    ORDERS {
        bigint id PK
        bigint customer_id FK
        order_status status "new | in_progress | ready | delivered | cancelled"
        date due_date
        delivery_method delivery_method "pickup | delivery"
        text notes
        numeric total "auto-calculated"
        uuid created_by FK
        timestamptz created_at
        timestamptz updated_at
    }
    ORDER_ITEMS {
        bigint id PK
        bigint order_id FK
        bigint product_id FK
        integer quantity
        numeric unit_price
        timestamptz created_at
    }
    STORAGE_PRODUCT_IMAGES {
        text bucket "product-images (private)"
    }
    STORAGE_ORDER_FILES {
        text bucket "order-files (private)"
    }
